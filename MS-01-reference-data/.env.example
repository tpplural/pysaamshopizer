# MS-01 reference-data — runtime config (see spec/shared/env-schema.md)
# reference-data requires: DATABASE_URL, REDIS_URL, SERVICE_PORT. No messaging.
DATABASE_URL=postgresql+psycopg://saam:saam_local@localhost:5432/shopizer_dev
REDIS_URL=redis://localhost:6379/0
SERVICE_PORT=8001
LOG_LEVEL=INFO
# DB schema for this service (db-per-service in prod; per-schema in shared dev DB)
DB_SCHEMA=reference_data
